    82: 89,
    89: 82,
    83: 83,
    87: 87,
    75: 77,
    77: 75,
    66: 86,
    86: 66,
    68: 72,
    72: 68,
    78: 78
};

/**
 * One-letter residue code -> its three-letter code.
 *
 * Covers the whole protein alphabet, unlike `RESIDUES`: the ambiguity codes
 * (`Asx`, `Glx`, `Xaa`, `Xle`) and the stop symbol (`Ter`) have a spelling
 * even though they have no mass or pKa.
 */
export def const THREE_LETTER as map of string to string init {
    "A": "Ala",
    "B": "Asx",
    "C": "Cys",
    "D": "Asp",
    "E": "Glu",
    "F": "Phe",
