# Codon table id -> the table itself, its NCBI name, and its start codons.
# Kept as three parallel maps rather than a struct so each stays a plain
# const the dispatchers below can read without building anything.

def const TABLE_NAMES as map of int to string init {
    1: "Standard",
    2: "Vertebrate Mitochondrial",
    3: "Yeast Mitochondrial",
    4: "Mold, Protozoan and Coelenterate Mitochondrial; Mycoplasma/Spiroplasma",
    5: "Invertebrate Mitochondrial",
    6: "Ciliate, Dasycladacean and Hexamita Nuclear",
    9: "Echinoderm and Flatworm Mitochondrial",
    10: "Euplotid Nuclear",
    11: "Bacterial, Archaeal and Plant Plastid"
};

def const TABLE_STARTS as map of int to string init {
    1: "TTG,CTG,ATG",
    2: "ATT,ATC,ATA,ATG,GTG",
    3: "ATA,ATG,GTG",
    4: "TTA,TTG,CTG,ATT,ATC,ATA,ATG,GTG",
    5: "TTG,ATT,ATC,ATA,ATG,GTG",
    6: "ATG",
    9: "ATG,GTG",
    10: "ATG",
    11: "TTG,CTG,ATT,ATC,ATA,ATG,GTG"
};

/**
 * IUPAC nucleotide ambiguity codes for DNA: code -> the bases it stands for.
 *
 * The four unambiguous bases map to themselves, so a lookup never needs a
 * special case. `N` is the fully ambiguous code.
 *
 * @see https://www.bioinformatics.org/sms2/iupac.html
 */
export def const IUPAC_DNA as map of string to string init {
    "A": "A",
    "C": "C",
    "G": "G",
    "T": "T",
    "R": "AG",
    "Y": "CT",
    "S": "CG",
    "W": "AT",
    "K": "GT",
    "M": "AC",
    "B": "CGT",
    "D": "AGT",
    "H": "ACT",
    "V": "ACG",
    "N": "ACGT"
};

/**
 * IUPAC nucleotide ambiguity codes for RNA - `IUPAC_DNA` with `U` for `T`.
 */
export def const IUPAC_RNA as map of string to string init {
    "A": "A",
    "C": "C",
    "G": "G",
    "R": "AG",
    "Y": "CU",
    "S": "CG",
    "W": "AU",
    "K": "GU",
    "M": "AC",
    "B": "CGU",
    "D": "AGU",
    "H": "ACU",
    "V": "ACG",
    "N": "ACGU",
    "U": "U"
};

/**
 * Watson-Crick complement of each DNA code, ambiguity codes included.
 *
 * The ambiguity codes complement as sets: `R` (A or G) complements to `Y`
 * (C or T), `B` (not A) to `V` (not T), and the self-complementary `S`, `W`
 * and `N` map to themselves.
 */
export def const COMPLEMENT_DNA as map of string to string init {
    "A": "T",
    "C": "G",
    "G": "C",
    "T": "A",
    "R": "Y",
    "Y": "R",
    "S": "S",
    "W": "W",
    "K": "M",
    "M": "K",
    "B": "V",
    "V": "B",
    "D": "H",
    "H": "D",
    "N": "N"
};

/**
 * Watson-Crick complement of each RNA code - `COMPLEMENT_DNA` with `U`
 * standing in for `T` on both sides.
 */
export def const COMPLEMENT_RNA as map of string to string init {
    "A": "U",
    "C": "G",
    "G": "C",
    "U": "A",
    "R": "Y",
    "Y": "R",
    "S": "S",
    "W": "W",
    "K": "M",
    "M": "K",
    "B": "V",
    "V": "B",
    "D": "H",
    "H": "D",
    "N": "N"
};

/**
 * One residue's identity, mass and physico-chemical properties.
 *
 * @field one {string} the one-letter code, e.g. "K"
 * @field three {string} the three-letter code, e.g. "Lys"
 * @field name {string} the full name, e.g. "Lysine"
 * @field monoMass {float} monoisotopic residue mass in daltons (the free
 *        amino acid less one water)
 * @field avgMass {float} average residue mass in daltons
 * @field pKa {float} side-chain dissociation constant, or 0.0 when the side
 *        chain does not ionise - the EMBOSS `iep` parameter set
 * @field charge {int} +1 basic, -1 acidic, 0 neutral side chain
 * @field hydropathy {float} Kyte-Doolittle hydropathy index, the input to
 *        `gravy`
 */
export def struct AminoAcid {
    one as string,
    three as string,
    name as string,
    monoMass as float,
    avgMass as float,
    pKa as float,
    charge as int,
    hydropathy as float
};

/**
 * pKa of the free alpha-amino group at the N terminus (EMBOSS `iep`).
 */
export def const PKA_N_TERMINUS as float init 8.6;

/**
 * pKa of the free alpha-carboxyl group at the C terminus (EMBOSS `iep`).
 */
export def const PKA_C_TERMINUS as float init 3.6;

/**
 * Monoisotopic mass of water, added once when residue masses are summed into
 * a peptide mass.
 */
export def const WATER_MONO_MASS as float init 18.010565;

/**
 * Average mass of water, the counterpart to `WATER_MONO_MASS`.
 */
export def const WATER_AVG_MASS as float init 18.01528;

# The residue table, keyed by one-letter code. `U` (selenocysteine) and `O`
