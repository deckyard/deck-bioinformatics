/**
 * Average residue mass of each DNA base, in daltons.
 *
 * Each value is the deoxyribonucleoside monophosphate less one water, so a
 * strand's mass is the sum of its residues plus one water. These are the
 * coefficients of the standard single-stranded oligo formula.
 */
export def const DNA_RESIDUE_MASS as map of string to float init {
    "A": 313.21,
    "C": 289.18,
    "G": 329.21,
    "T": 304.19
};

/**
 * Average residue mass of each RNA base, in daltons - the ribonucleoside
 * counterpart of `DNA_RESIDUE_MASS`.
 */
export def const RNA_RESIDUE_MASS as map of string to float init {
    "A": 329.21,
    "C": 305.18,
    "G": 345.21,
    "U": 306.17
};

/**
 * Average mass of a metaphosphate group (HPO3), subtracted to report an
 * oligo with a free 5' hydroxyl rather than a 5' phosphate.
 */
export def const PHOSPHATE_MASS as float init 79.98;

/**
 * Nearest-neighbour enthalpy dH, in kcal/mol, for every dinucleotide.
 *
 * SantaLucia (1998) unified parameters. A duplex reads the same from either
 * strand, so a dinucleotide and its reverse complement share one parameter;
 * the ten published values are expanded to all sixteen here.
 *
 * @see SantaLucia J (1998) PNAS 95:1460-1465
 */
export def const NN_ENTHALPY as map of string to float init {
    "AA": -7.9,
    "AC": -8.4,
    "AG": -7.8,
    "AT": -7.2,
    "CA": -8.5,
    "CC": -8.0,
    "CG": -10.6,
    "CT": -7.8,
    "GA": -8.2,
    "GC": -9.8,
    "GG": -8.0,
    "GT": -8.4,
    "TA": -7.2,
    "TC": -8.2,
    "TG": -8.5,
    "TT": -7.9
};

/**
 * Nearest-neighbour entropy dS, in cal/(mol K), the companion to
 * `NN_ENTHALPY`.
 */
export def const NN_ENTROPY as map of string to float init {
    "AA": -22.2,
    "AC": -22.4,
    "AG": -21.0,
    "AT": -20.4,
    "CA": -22.7,
    "CC": -19.9,
    "CG": -27.2,
    "CT": -21.0,
    "GA": -22.2,
    "GC": -24.4,
    "GG": -19.9,
    "GT": -22.4,
    "TA": -21.3,
    "TC": -22.2,
    "TG": -22.7,
    "TT": -22.2
};

# Helix-initiation corrections, applied once per duplex end, and the symmetry
# correction for a self-complementary strand (SantaLucia 1998).
def const NN_INIT_GC_ENTHALPY as float init 0.1;
def const NN_INIT_GC_ENTROPY as float init -2.8;
def const NN_INIT_AT_ENTHALPY as float init 2.3;
def const NN_INIT_AT_ENTROPY as float init 4.1;
def const NN_SYMMETRY_ENTROPY as float init -1.4;

/**
 * The gas constant in cal/(mol K), as used by the nearest-neighbour model.
 */
export def const GAS_CONSTANT as float init 1.987;

/**
 * BLOSUM62, the default substitution matrix for protein alignment.
 *
 * Keyed by the concatenated residue pair, so `BLOSUM62["WW"]` is 11 and
 * `BLOSUM62["AR"]` is -1. The matrix is symmetric, so only one order of
 * each pair is stored - read it through `substitutionScore`, which tries
 * both, rather than indexing it directly.
