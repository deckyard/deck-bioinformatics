    "T": "Thr",
    "U": "Sec",
    "V": "Val",
    "W": "Trp",
    "X": "Xaa",
    "Y": "Tyr",
    "Z": "Glx",
    "*": "Ter"
};

# Three-letter code (uppercased) -> one-letter code, the inverse of
# THREE_LETTER, for threeToOne.
def const ONE_LETTER as map of string to string init {
    "ALA": "A",
