# Byte-keyed complements, for the per-residue loops in transforms.j. Same
# content as COMPLEMENT_DNA / COMPLEMENT_RNA above, keyed by ASCII code so a
# loop can complement a byte without materialising a one-character string -
# the convention core.j sets out. tables_test.j checks the two agree.
def const COMPLEMENT_DNA_CODES as map of int to int init {
    65: 84,
